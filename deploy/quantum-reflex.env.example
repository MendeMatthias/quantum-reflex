# Copy to /etc/quantum-reflex.env and fill in. `chmod 600` it (it holds the
# session secret). Referenced by quantum-reflex.service (EnvironmentFile).

# The EXACT public origin users land on, AFTER any apex/www or http->https
# redirect. No path, no trailing slash. This must equal what the browser shows
# in location.origin, or /qid/verify rejects every proof with bad_origin.
QID_ORIGIN=https://play.qid.dev

# 32+ random chars. Generate:  openssl rand -hex 24
# Rotating this signs everyone out (invalidates all sessions).
QID_SESSION_SECRET=CHANGE_ME

# Durable SQLite: qID nonces + accounts AND the leaderboard. Keep it on the
# systemd StateDirectory so it survives restarts and is the only writable path.
QID_DB=/var/lib/quantum-reflex/qr.sqlite

# Bind localhost only; Caddy fronts TLS on 443.
QID_HOST=127.0.0.1
QID_PORT=8899

# Optional. Per-address score rate limit in ms (default 2000). 0 disables.
# QR_RATE_MS=2000

# Relic-name feature: let a player claim their spot under the name they forged
# into a BTX relic they hold (Attribute Archive name-on-chain, Last Relic
# engraving). Read-only, best-effort, cached; a failure just hides the option.
# QR_BTXSCAN=https://btxscan.io    # holder + artifact record source
# QR_RELICS=on                     # off/0/false disables the lookup entirely
# QR_RELIC_TTL_MS=600000           # per-address cache (default 10 min)
# QR_RELIC_DEBUG_ADDRESS=          # DEV ONLY (http origins): resolve THIS
#                                  # address's relics for any caller, to demo the
#                                  # chips without a wallet. Inert over https.
